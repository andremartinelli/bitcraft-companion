# Copie para .env.production e preencha o APP_KEY (node ace generate:key --show).
# Usado por scripts/start-production.ps1, que copia este arquivo para build/.env.

# Node
TZ=UTC
PORT=3333
# 0.0.0.0 aceita conexões de outras máquinas (Tailscale), não só do localhost
HOST=0.0.0.0
NODE_ENV=production

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://localhost:3333

# Session
SESSION_DRIVER=cookie
# O acesso pelo Tailscale é HTTP puro; só mude para true quando houver HTTPS
SESSION_SECURE_COOKIE=false

# Database: caminho absoluto, fora de build/ (que é apagado a cada build).
# Nunca coloque este arquivo numa pasta sincronizada (Drive, OneDrive).
DB_DATABASE=C:\Projects\bitcraft-companion\storage\production.sqlite3
