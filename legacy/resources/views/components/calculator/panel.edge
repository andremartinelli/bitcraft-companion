{{--
  The calculator: targets form, item picker and result. Rendered inside the
  calculator and plan pages, and alone for htmx requests (swaps #calculator).
  State: panel (presenter output), errors, form { method, action }, saveFields (quick mode only).
--}}
<div id="calculator" class="calc" x-data>
  <div class="calc__picker">
    <label for="calc-search" class="calc__label">Adicionar item ou construção</label>
    <input
      id="calc-search"
      class="field__input"
      type="search"
      name="q"
      placeholder="Ex.: Pyrelite Axe, Simple Plank, Rough Loom"
      autocomplete="off"
      hx-get="{{ route('items.index') }}"
      hx-trigger="input changed delay:250ms, search"
      hx-target="#item-suggestions"
      hx-swap="innerHTML"
    />
  </div>

  <form
    id="calc-form"
    class="calc__form"
    method="GET"
    action="{{ form.action }}"
    hx-{{ form.method }}="{{ form.action }}"
    hx-target="#calculator"
    hx-swap="outerHTML"
    hx-trigger="change, submit"
  >
    <div id="item-suggestions" class="calc__suggestions" aria-live="polite"></div>

    @if(errors && errors.length)
      <div class="calc__errors" role="alert">
        @each(message in errors)
          <p>{{ message }}</p>
        @end
      </div>
    @end

    @if(!panel.empty)
      {{-- Scrolls past about five items; keeps its position when the panel redraws --}}
      <div class="calc__targets-scroll" x-data="targetsScroll({{ panel.targets.length + panel.buildings.length }})" x-on:scroll.debounce.100ms="save()">
      <table class="calc__targets">
        <thead>
          <tr><th>Item</th><th class="num">Quantidade</th><th></th></tr>
        </thead>
        <tbody>
          @each(target in panel.targets)
            <tr>
              <td>
                <input type="hidden" name="targets[{{ target.index }}][item_id]" value="{{ target.item.id }}" />
                @!itemChip({ item: target.item })
                @if(target.item.removed)
                  <span class="flag">saiu do jogo</span>
                @end
              </td>
              <td class="num">
                <input
                  id="target-qty-{{ target.item.id }}"
                  class="field__input calc__qty"
                  type="number"
                  min="1"
                  max="100000"
                  name="targets[{{ target.index }}][quantity]"
                  value="{{ target.quantity }}"
                  aria-label="Quantidade de {{ target.item.name }}"
                />
              </td>
              <td>
                <button type="submit" name="remove" value="{{ target.index }}" class="btn btn--ghost btn--sm" aria-label="Remover {{ target.item.name }}">
                  Remover
                </button>
              </td>
            </tr>
          @end
          @each(building in panel.buildings)
            <tr>
              <td>
                <input type="hidden" name="buildings[{{ building.index }}][recipe_id]" value="{{ building.recipe.id }}" />
                <span class="chip chip--static">{{ building.recipe.name }}</span>
                <span class="badge badge--rarity">construção</span>
                @if(building.removed)
                  <span class="flag">saiu do jogo</span>
                @end
              </td>
              <td class="num">
                <input
                  id="building-qty-{{ building.recipe.id }}"
                  class="field__input calc__qty"
                  type="number"
                  min="1"
                  max="1000"
                  name="buildings[{{ building.index }}][quantity]"
                  value="{{ building.quantity }}"
                  aria-label="Quantidade de {{ building.recipe.name }}"
                />
              </td>
              <td>
                <button type="submit" name="remove_building" value="{{ building.index }}" class="btn btn--ghost btn--sm" aria-label="Remover {{ building.recipe.name }}">
                  Remover
                </button>
              </td>
            </tr>
          @end
        </tbody>
      </table>
      </div>
    @end

    @each(choice in panel.choices)
      <input type="hidden" name="choices[i{{ choice.itemId }}]" value="{{ choice.value }}" />
    @end
    @each(entry in panel.owned)
      <input type="hidden" name="owned[i{{ entry.itemId }}]" value="{{ entry.quantity }}" />
    @end

    @if(panel.inventory.available)
      <div class="calc__inventory">
        <input type="hidden" name="inventory" value="{{ panel.useInventory ? '1' : '0' }}" x-ref="inventoryField" />
        <label for="calc-inventory" class="calc__inventory-toggle">
          <input
            id="calc-inventory"
            type="checkbox"
            {{ panel.useInventory ? 'checked' : '' }}
            x-on:change="$refs.inventoryField.value = $event.target.checked ? '1' : '0'"
          />
          Usar inventário do grupo
        </label>
        <span class="muted">
          sincronizado {{ formatAgo(panel.inventory.syncedAt) }} · o "já tenho" digitado tem prioridade
        </span>
        {{-- Submits #calc-sync, below: a form can't sit inside this one --}}
        <button type="submit" form="calc-sync" class="btn btn--secondary btn--sm calc__sync-button">Sincronizar agora</button>
        <span id="calc-sync-status" class="muted" hidden>Sincronizando com a BitJita…</span>
      </div>
    @end
    <noscript><button type="submit" class="btn btn--primary btn--sm">Calcular</button></noscript>
  </form>

  @if(panel.inventory.available)
    {{--
      Reads BitJita now and comes back to this page (the plan, or the
      calculator with its URL), which recalculates with the new inventory.
    --}}
    <form
      id="calc-sync"
      method="POST"
      action="{{ route('inventory.sync') }}"
      x-data
      x-on:submit="
        $el.elements.return_to.value = location.pathname + location.search;
        document.querySelector('[form=calc-sync]').disabled = true;
        document.getElementById('calc-sync-status').hidden = false
      "
    >
      {{ csrfField() }}
      <input type="hidden" name="return_to" value="{{ form.action }}" />
    </form>
  @end

  @if(saveFields && !panel.empty)
    <form class="calc__save" method="POST" action="{{ route('plans.store') }}">
      {{ csrfField() }}
      @each(field in saveFields)
        <input type="hidden" name="{{ field[0] }}" value="{{ field[1] }}" />
      @end
      <input id="plan-name" class="field__input" type="text" name="name" maxlength="80" required placeholder="Nome do plano, ex.: Ferramentas T2" aria-label="Nome do plano" />
      <button type="submit" class="btn btn--secondary btn--sm">Salvar como plano</button>
    </form>
  @end

  @include('components/calculator/result')
</div>
