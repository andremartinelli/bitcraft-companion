{{--
  Item picker suggestions. Buttons submit #calc-form with add=<item id>, or
  add_building=<construction recipe id> for a building (a Loom, a Kiln...).
--}}
@if(items.length || buildings.length)
  <div class="suggestions">
    @each(building in buildings)
      <button type="submit" form="calc-form" name="add_building" value="{{ building.id }}" class="suggestion">
        <span>{{ building.name }}</span>
        <span class="badge badge--rarity">construção</span>
      </button>
    @end
    @each(item in items)
      <button type="submit" form="calc-form" name="add" value="{{ item.id }}" class="suggestion">
        <span>{{ item.name }}</span>
        @if(item.tier > 0)
          <span class="badge badge--tier">T{{ item.tier }}</span>
        @end
        @if(item.itemListGameId)
          <span class="badge badge--rarity" title="O craft dá este item com raridade sorteada">resultado do craft</span>
        @elseif(rarityLabel(item.rarity))
          <span class="badge badge--rarity">{{ rarityLabel(item.rarity) }}</span>
        @end
        @if(item.kind === 'cargo')
          <span class="muted">cargo</span>
        @end
      </button>
    @end
  </div>
@elseif(q && q.length >= 2)
  <p class="muted">Nada encontrado.</p>
@end
