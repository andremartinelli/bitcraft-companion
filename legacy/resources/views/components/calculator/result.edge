{{--
  Calculator result. Uses `panel` and `form` (the rounds remember, per page,
  which ones were folded). Round 1 gathers the raw materials; the next ones
  make each item once, in an order that works. The full tree, for changing
  recipes and "já tenho", stays folded at the end.
--}}
@if(panel.empty)
  <div class="empty calc__empty">
    <p>Adicione itens ou construções (um Loom, um Kiln...) para ver a matéria-prima e as etapas até o fim da cadeia.</p>
    <p class="muted">Em cada etapa dá para trocar a receita ou marcar o que vocês já têm.</p>
  </div>
@else
  @if(panel.warnings.length)
    <div class="calc__warnings" role="status">
      @each(warning in panel.warnings)
        <p>{{ warning }}</p>
      @end
    </div>
  @end

  <section class="calc__box" aria-labelledby="calc-steps">
    <div class="calc__steps-head">
      <h2 id="calc-steps" class="calc__title">Etapas</h2>
      @if(panel.completeCount)
        {{-- Folds every round and profession marked data-complete; each one remembers it --}}
        <button
          type="button"
          class="btn btn--ghost btn--sm"
          x-data
          x-on:click="$root.closest('section').querySelectorAll('details[data-complete]').forEach((d) => (d.open = false))"
        >Colapsar todos os concluídos ({{ panel.completeCount }})</button>
      @end
    </div>
    <p class="calc__hint calc__hint--top">Primeiro, coletar a matéria-prima. Depois, cada item uma vez, somando a árvore inteira: uma rodada só depende das anteriores e, dentro dela, vai por estação. <strong>Riscado é o que vocês já têm:</strong> não precisa fazer nem coletar o que vai nele.</p>

    <details class="round" open {{ panel.gatherComplete ? 'data-complete' : '' }} x-data="rememberOpen('{{ form.action }}:round:1')" x-on:toggle="remember()">
      <summary class="round__summary">
        <span class="round__title">Rodada 1 · Coletar</span>
        <span class="round__count">
          @if(panel.materials.length)
            {{ panel.materialsDone }} de {{ panel.materials.length }} completas
          @else
            nada a coletar
          @end
        </span>
      </summary>
      @each(profession in panel.materialGroups)
        <details class="profession" open {{ profession.complete ? 'data-complete' : '' }} x-data="rememberOpen('{{ form.action }}:round:1:{{ profession.key }}')" x-on:toggle="remember()">
        <summary class="steps__profession">{{ profession.name }}
          <span>{{ profession.entries.length }} {{ profession.entries.length === 1 ? 'item' : 'itens' }}{{ profession.doneCount ? ` · ${profession.doneCount} ${profession.doneCount === 1 ? 'completo' : 'completos'}` : '' }}</span>
        </summary>
        <ul class="steps">
          @each(row in profession.entries)
            {{--
              Complete: struck through and muted. Covered: it already went into
              products they have (the wood in their planks), and the row says so.
            --}}
            <li class="steps__row gather__row {{ row.complete ? 'is-done' : '' }}">
              <span class="steps__qty">{{ row.qtyLabel }}</span>
              <span class="steps__main">
                @!itemChip({ item: row.item })
                @if(row.holdersLabel)
                  <span class="gather__holders">{{ row.holdersLabel }}</span>
                @end
                @if(!row.complete)
                  <span class="gather__status">faltam {{ row.approximate ? '≈ ' : '' }}{{ formatNumber(row.missing) }}{{ row.coveredLabel ? ` · ${row.coveredLabel}` : '' }}</span>
                @elseif(row.coveredLabel)
                  <span class="steps__status">{{ row.coveredLabel }}</span>
                @else
                  <span class="sr-only">completo</span>
                @end
              </span>
            </li>
          @end
        </ul>
        </details>
      @end
      @if(panel.materials.length)
        <p class="calc__hint round__hint">À esquerda, o que vocês têm / o que o plano precisa; ao lado do item, com quem está. Riscado com "já têm em": já foi usado em algo pronto que vocês têm.</p>
      @else
        <p class="muted round__hint">Nada para coletar: vocês já têm tudo.</p>
      @end
    </details>

    @each(group in panel.rounds)
      <details class="round" open {{ group.complete ? 'data-complete' : '' }} x-data="rememberOpen('{{ form.action }}:round:{{ group.round }}')" x-on:toggle="remember()">
        <summary class="round__summary">
          <span class="round__title">Rodada {{ group.round }}</span>
          <span class="round__count">{{ group.countLabel }}</span>
        </summary>
        @each(profession in group.professions)
          <details class="profession" open {{ profession.complete ? 'data-complete' : '' }} x-data="rememberOpen('{{ form.action }}:round:{{ group.round }}:{{ profession.key }}')" x-on:toggle="remember()">
          <summary class="steps__profession">{{ profession.name }}
            <span>{{ profession.countLabel }}</span>
          </summary>
          <ul class="steps">
            @each(step in profession.entries)
              {{-- Done: they have it all; it shows struck through, like a complete raw material --}}
              <li class="steps__row {{ step.done ? 'is-done' : step.ready ? 'is-ready' : '' }}">
                <span class="steps__qty">
                  @if(step.done)
                    {{ step.approximate ? '≈ ' : '' }}{{ formatNumber(step.quantity) }} / {{ formatNumber(step.quantity) }}
                  @else
                    {{ step.approximate ? '≈ ' : '' }}{{ formatNumber(step.wholeCrafts) }}×
                  @end
                </span>
                <span class="steps__main">
                  @!itemChip({ item: step.item })
                  @!calculator.stepWhere({ step })
                  @if(step.done)
                    <span class="steps__status">{{ step.haveLabel }}</span>
                  @elseif(step.ready)
                    <span class="steps__status steps__status--ready">
                      @svg('lucide:circle-check', { width: 14, height: 14, 'aria-hidden': 'true' })
                      pronto para fazer
                    </span>
                  @elseif(step.wholeReadyCrafts > 0)
                    <span class="steps__status">{{ formatNumber(step.wholeReadyCrafts) }} de {{ formatNumber(step.wholeCrafts) }} já dá para fazer · espera {{ step.waitingLabel }}</span>
                  @else
                    <span class="steps__status">espera {{ step.waitingLabel }}</span>
                  @end
                </span>
              </li>
            @end
          </ul>
          </details>
        @end
      </details>
    @end
    @if(!panel.rounds.length && !panel.buildRound)
      <p class="muted round__hint">Nada para fabricar: vocês já têm tudo.</p>
    @end

    @if(panel.buildRound)
      {{-- The buildings, once everything they take is made --}}
      <details class="round" open x-data="rememberOpen('{{ form.action }}:round:build')" x-on:toggle="remember()">
        <summary class="round__summary">
          <span class="round__title">Rodada {{ panel.buildRound.round }} · Construir</span>
          <span class="round__count">{{ panel.buildRound.entries.length }} {{ panel.buildRound.entries.length === 1 ? 'construção' : 'construções' }}</span>
        </summary>
        <ul class="steps">
          @each(build in panel.buildRound.entries)
            <li class="steps__row {{ build.ready ? 'is-ready' : '' }}">
              <span class="steps__qty">{{ formatNumber(build.quantity) }}×</span>
              <span class="steps__main">
                <span class="chip chip--static">{{ build.recipe.name }}</span>
                @if(build.flowLabel)
                  <span class="steps__flow">{{ build.flowLabel }}</span>
                @end
                <span class="steps__meta">{{ build.recipe.skillName ?? 'Construção' }}{{ build.recipe.skillLevel ? ` Nv ${build.recipe.skillLevel}` : '' }}{{ build.recipe.toolName ? ` · ${build.recipe.toolName} T${build.recipe.toolTier}` : '' }}</span>
                @if(build.ready)
                  <span class="steps__status steps__status--ready">
                    @svg('lucide:circle-check', { width: 14, height: 14, 'aria-hidden': 'true' })
                    pronto para construir
                  </span>
                @else
                  <span class="steps__status">espera {{ build.waitingLabel }}</span>
                @end
              </span>
            </li>
          @end
        </ul>
      </details>
    @end
  </section>

  <details class="calc__tree" x-data="rememberOpen('calc:tree')" x-on:toggle="remember()">
    <summary class="calc__tree-summary">
      <h2 class="calc__title">Árvore de produção</h2>
      <span class="muted">trocar receitas e corrigir o "já tenho"</span>
    </summary>
    <p class="calc__hint calc__hint--top">Troque a receita de cada etapa ou informe quanto vocês já têm. "≈" marca valores médios de saídas aleatórias.</p>
    @each(build in panel.buildTrees)
      <div class="node">
        <div class="node__line">
          <span class="node__qty">{{ formatNumber(build.quantity) }}</span>
          <span class="chip chip--static">{{ build.recipe.name }}</span>
          <span class="node__reason">construção{{ build.recipe.skillName ? ` · ${build.recipe.skillName} Nv ${build.recipe.skillLevel}` : '' }}</span>
        </div>
        <div class="node__children">
          @each(child in build.children)
            @!calculator.node({ node: child, depth: 1 })
          @end
        </div>
      </div>
    @end
    @each(node in panel.trees)
      @!calculator.node({ node, depth: 0 })
    @end
  </details>
@end
