{{-- One tier of the "Planos rápidos" menu: creates the plan. Uses quick, option and, for the metal set, style. --}}
<li role="none">
  @form({ route: 'quick_plans.store', method: 'POST', class: 'qmenu__form' })
    <input type="hidden" name="template" value="{{ quick.key }}" />
    <input type="hidden" name="tier" value="{{ option.tier }}" />
    @if(quick.styles)
      <input type="hidden" name="style" value="{{ style }}" />
    @end
    <button type="submit" role="menuitem" class="qmenu__item">
      <span class="qmenu__label">T{{ option.tier }} · {{ option.material }}</span>
      <span class="qmenu__hint">{{ option.count === 1 ? '1 item' : `${option.count} itens` }}</span>
    </button>
  @end
</li>
