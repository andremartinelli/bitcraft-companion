{{--
  The inventory: sync status, tabs, search and list. Rendered inside the page
  and alone after "Sincronizar agora" (htmx swaps #inventory).
  State: status { latest, lastGood, notices, players }, notice, tabs, filters, listing, empty.
--}}
<div id="inventory" class="inventory">
  <section class="inventory__status" aria-live="polite">
    <div class="inventory__sync">
      <div>
        @if(status.latest)
          <p>
            Última sincronização {{ formatAgo(status.latest.startedAt) }}:
            <strong>{{ status.latest.statusLabel }}</strong>
            <span class="muted">· fonte: BitJita</span>
          </p>
          @if(status.lastGood)
            <p class="muted">Os dados abaixo são da última sincronização que funcionou, {{ formatAgo(status.lastGood.startedAt) }}.</p>
          @end
        @else
          <p>Ainda não houve sincronização.</p>
        @end
      </div>
      @if(status.players.length)
        <form
          class="inventory__sync-form"
          method="POST"
          action="{{ route('inventory.sync') }}"
          hx-post="{{ route('inventory.sync') }}"
          hx-target="#inventory"
          hx-swap="outerHTML"
          hx-disabled-elt="find button"
          hx-include="#inventory-q"
        >
          {{ csrfField() }}
          <input type="hidden" name="tab" value="{{ filters.tab }}" />
          {{-- With htmx the search box (#inventory-q) is sent instead, as typed --}}
          <noscript><input type="hidden" name="q" value="{{ filters.q ?? '' }}" /></noscript>
          <span class="htmx-indicator muted">Sincronizando…</span>
          <button type="submit" class="btn btn--primary btn--sm">Sincronizar agora</button>
        </form>
      @end
    </div>

    @if(notice)
      <p class="inventory__notice" role="status">{{ notice }}</p>
    @end
    @if(status.notices.length)
      <div class="calc__warnings" role="status">
        @each(line in status.notices)
          <p>{{ line }}</p>
        @end
      </div>
    @end
  </section>

  @if(!status.players.length)
    <div class="empty">
      <p>Nenhum personagem cadastrado. Adicione os personagens de vocês para ler o inventário.</p>
      <a href="{{ route('game_players.index') }}" class="btn btn--secondary btn--sm">Adicionar personagens</a>
    </div>
  @else
    <nav class="tabs" aria-label="Visão do inventário">
      @each(tab in tabs)
        <a
          href="{{ route('inventory.index', [], { qs: tab.qs }) }}"
          class="tabs__item"
          aria-current="{{ filters.tab === tab.value ? 'page' : 'false' }}"
        >{{ tab.label }}</a>
      @end
    </nav>

    <form
      class="filters"
      method="GET"
      action="{{ route('inventory.index') }}"
      hx-get="{{ route('inventory.index') }}"
      hx-target="#inventory-list"
      hx-swap="outerHTML"
      hx-trigger="input delay:300ms, submit"
      hx-push-url="true"
    >
      @if(filters.tab !== 'group')
        <input type="hidden" name="tab" value="{{ filters.tab }}" />
      @end
      <input
        id="inventory-q"
        class="field__input filters__search"
        type="search"
        name="q"
        value="{{ filters.q ?? '' }}"
        placeholder="Buscar item (ex.: plank, ingot)"
        autocomplete="off"
        aria-label="Buscar item"
      />
      <noscript><button class="btn btn--primary btn--sm" type="submit">Buscar</button></noscript>
    </form>

    @include('components/inventory/list')
  @end
</div>
