{{--
  Link to an item page: "2× Rough Plank T1 Raro". Props: item, quantity (optional), output (bool).
--}}
@let(item = $props.get('item'))
@let(quantity = $props.get('quantity'))
<a href="{{ route('items.show', { id: item.id }) }}" class="chip {{ $props.get('output') ? 'chip--out' : '' }}">
  @if(quantity !== undefined && quantity !== null)
    <span class="chip__qty">{{ formatNumber(quantity) }}×</span>
  @end
  <span>{{ item.name }}</span>
  @if(item.tier > 0)
    <span class="badge badge--tier">T{{ item.tier }}</span>
  @end
  @if(rarityLabel(item.rarity))
    <span class="badge badge--rarity">{{ rarityLabel(item.rarity) }}</span>
  @end
</a>
