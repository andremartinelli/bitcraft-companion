@layouts.app({ title: 'Itens' })
  @page({ title: 'Itens' })
    <form method="GET" action="{{ route('items.index') }}" class="filters">
      <input id="items-q" class="field__input filters__search" type="search" name="q" value="{{ q ?? '' }}" placeholder="Nome do item" aria-label="Buscar item" />
      <button type="submit" class="btn btn--primary btn--sm">Buscar</button>
    </form>
    <div class="chips">
      @each(item in items)
        @!itemChip({ item })
      @else
        <p class="muted">{{ q ? 'Nenhum item encontrado.' : 'Digite pelo menos 2 letras.' }}</p>
      @end
    </div>
  @end
@end
