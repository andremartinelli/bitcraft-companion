# Node
TZ=UTC
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
# Only true once the app is served over HTTPS (Tailscale access is plain HTTP)
SESSION_SECURE_COOKIE=false
# Login is off: anyone who reaches the server uses the app. true asks for an account
LOGIN_REQUIRED=false

# Database: a file name inside ./tmp, or an absolute path
DB_DATABASE=db.sqlite3
# Print SQL queries in development (they include values: keep off when handling accounts)
DB_DEBUG=false

# Inventory: minutes between automatic syncs with BitJita (0 turns them off)
INVENTORY_SYNC_MINUTES=1
