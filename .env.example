# Copy to .env. On Vercel, the same variables go in the project's dashboard.

# The app's database. Local: the Postgres from `npm run db:dev`. On Neon: the pooled URL (-pooler in the host).
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Migrations and scripts (import, users). On Neon: the direct URL, without the pooler.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Local only: the temporary database that `prisma migrate dev` uses to compare
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable
# Integration tests: the Postgres from `npm run db:test` (emptied before every test)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:51224/template1?sslmode=disable

# Signs the session cookie. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# Vercel sends this key on the daily inventory cron
CRON_SECRET=
# Minutes until the inventory is considered stale and syncs when a page is opened
INVENTORY_STALE_MINUTES=1
