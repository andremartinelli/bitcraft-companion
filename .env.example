# Copie para .env. Na Vercel, as mesmas variáveis vão no painel do projeto.

# Banco do app. Local: o Postgres do `npm run db:dev`. No Neon: a URL com pooler (-pooler no host).
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Migrations e scripts (importação, usuários). No Neon: a URL direta, sem pooler.
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
# Só local: o banco temporário que o `prisma migrate dev` usa para comparar
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:51215/template1?sslmode=disable
# Testes de integração: o Postgres do `npm run db:test` (zerado a cada teste)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:51224/template1?sslmode=disable

# Assina o cookie de sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# A Vercel manda esta chave no cron diário do inventário
CRON_SECRET=
# Minutos até o inventário ser considerado velho e sincronizar ao abrir uma página
INVENTORY_STALE_MINUTES=15
