{
  "name": "bitcraft-companion",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "prisma generate && next build",
    "start": "next start --port 3100",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev --name bitcraft-dev --port 51213 --db-port 51214 --shadow-db-port 51215",
    "db:test": "prisma dev --name bitcraft-test --port 51223 --db-port 51224 --shadow-db-port 51225",
    "game-data:import": "tsx scripts/import-game-data.ts",
    "users:create": "tsx scripts/create-user.ts",
    "inventory:sync": "tsx scripts/sync-inventory.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "3.38.0",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "jose": "6.2.18",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "esbuild": true,
    "prisma": true
  }
}
