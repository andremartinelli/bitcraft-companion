{{-- Recipe, station and skill of a step. Props: step. --}}
@let(recipe = $props.get('step').recipe)
@if(recipe)
  <span class="steps__meta">
    {{ recipe.name }} · {{ recipe.stationName ? `${recipe.stationName} T${recipe.stationTier}` : 'sem estação' }}{{ recipe.skillName ? ` · ${recipe.skillName} Nv ${recipe.skillLevel}` : '' }}
  </span>
@end
