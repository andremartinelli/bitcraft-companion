{{--
  The stock, one table per section (a profession, the group, a player, a
  place). Sections collapse (<details>); the browser remembers which ones,
  except during a search, which shows every match. Rendered inside the panel
  and alone for the item search (htmx swaps #inventory-list).
  State: filters { tab, q }, listing { sections }, empty.
--}}
<div id="inventory-list" x-data="inventorySections({{ filters.q ? 'true' : 'false' }})">
  @if(empty)
    <div class="empty">
      @if(filters.q)
        <p>Nenhum item com "{{ filters.q }}" no inventário.</p>
      @else
        <p>Nada no inventário ainda. Clique em "Sincronizar agora".</p>
      @end
    </div>
  @elseif(filters.tab === 'group')
    @each(section in listing.sections)
      <div class="inventory__section">
        @include('components/inventory/table')
      </div>
    @end
  @else
    <div class="inventory__toolbar">
      <button type="button" class="btn btn--ghost btn--sm" x-on:click="setAll(true)">Expandir tudo</button>
      <button type="button" class="btn btn--ghost btn--sm" x-on:click="setAll(false)">Recolher tudo</button>
    </div>
    @each(section in listing.sections)
      <details class="inventory__section inventory__fold" open data-key="{{ section.key }}" x-on:toggle="remember($el)">
        <summary class="inventory__summary">
          <span class="inventory__title">{{ section.title }}</span>
          @if(section.subtitle)
            <span class="inventory__subtitle">{{ section.subtitle }}</span>
          @end
          <span class="inventory__count">{{ section.lines.length === 1 ? '1 item' : `${section.lines.length} itens` }}</span>
        </summary>
        @include('components/inventory/table')
      </details>
    @end
  @end
</div>
