{{--
  The stock, one table per section (a profession, the group, a player, a
  place). Rendered inside the panel and alone for the item search (htmx
  swaps #inventory-list).
  State: filters { tab, q }, listing { sections }, empty.
--}}
<div id="inventory-list">
  @if(empty)
    <div class="empty">
      @if(filters.q)
        <p>Nenhum item com "{{ filters.q }}" no inventário.</p>
      @else
        <p>Nada no inventário ainda. Clique em "Sincronizar agora".</p>
      @end
    </div>
  @else
    @each(section in listing.sections)
      <section class="inventory__section">
        @if(filters.tab !== 'group')
          <h2 class="inventory__title">{{ section.title }}</h2>
          @if(section.subtitle)
            <p class="inventory__subtitle">{{ section.subtitle }}</p>
          @end
        @end
        <div class="ledger">
          <table class="stock">
            <tbody>
              @each(line in section.lines)
                <tr>
                  <td class="stock__item">
                    @!itemChip({ item: line.item })
                  </td>
                  <td class="num">{{ formatNumber(line.quantity) }}</td>
                  @if(filters.tab === 'professions')
                    <td>
                      <div class="stock__where">
                        @each(place in line.where)
                          <span class="stock__place">
                            <span class="stock__place-qty">{{ formatNumber(place.quantity) }}</span>
                            {{ place.container }}
                            <span class="muted">· {{ place.owner }}</span>
                          </span>
                        @end
                      </div>
                    </td>
                  @elseif(filters.tab === 'group')
                    <td class="stock__places">{{ line.where.length === 1 ? '1 local' : `${line.where.length} locais` }}</td>
                  @end
                </tr>
              @end
            </tbody>
          </table>
        </div>
      </section>
    @end
  @end
</div>
