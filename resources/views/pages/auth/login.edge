@layouts.auth()
  <h1 class="auth__title">Entrar</h1>
  <p class="auth__sub">Use a conta criada com <span class="kbd">node ace users:create</span>.</p>
  @form({
    route: 'session.store',
    method: 'POST',
    class: 'auth__form',
    'x-data': '{ submitting: false }',
    'x-on:submit': 'submitting = true',
  })
    @field.root({ name: 'email' })
      @!field.label({ text: 'E-mail' })
      @!input.control({
        type: 'email',
        autocomplete: 'username',
        placeholder: 'voce@exemplo.com',
      })
      @!field.error()
    @end
    @field.root({ name: 'password' })
      @!field.label({ text: 'Senha' })
      @!input.control({
        type: 'password',
        autocomplete: 'current-password',
        placeholder: '••••••••',
      })
      @!field.error()
    @end
    @!button({
      text: 'Entrar',
      type: 'submit',
      block: true,
      style: 'margin-top: 4px;',
      'x-bind:disabled': 'submitting',
      'x-text': "submitting ? 'Um momento…' : 'Entrar'",
    })
  @end
@end
