@layouts.app({ title: 'Planos' })
  @page({ title: 'Planos', description: 'Cálculos salvos, compartilhados entre vocês. Para criar um, monte o cálculo na calculadora e salve como plano.' })
    @slot('actions')
      <a href="{{ route('calculator.show') }}" class="btn btn--primary btn--sm">Nova calculadora</a>
    @end

    @if(quickPlans.length)
      <section class="quick-plans" aria-labelledby="quick-plans-title">
        <h2 id="quick-plans-title" class="item-section__title">Planos rápidos</h2>
        <div class="quick-plans__grid">
          @each(quick in quickPlans)
            @form({ route: 'quick_plans.store', method: 'POST', class: 'quick-plan' })
              <input type="hidden" name="template" value="{{ quick.key }}" />
              <p class="quick-plan__title">{{ quick.label }}</p>
              <p class="quick-plan__description">{{ quick.description }}</p>
              <div class="quick-plan__controls">
                <select id="quick-{{ quick.key }}-tier" name="tier" class="field__input" aria-label="Tier: {{ quick.label }}">
                  @each(option in quick.tiers)
                    <option value="{{ option.tier }}">{{ option.label }}</option>
                  @end
                </select>
                @if(quick.styles)
                  <select id="quick-{{ quick.key }}-style" name="style" class="field__input" aria-label="Estilo: {{ quick.label }}">
                    @each(style in quick.styles)
                      <option value="{{ style }}">{{ style }}</option>
                    @end
                  </select>
                @end
                <button type="submit" class="btn btn--secondary btn--sm">Criar plano</button>
              </div>
            @end
          @end
        </div>
      </section>
    @end

    @if(plans.length)
      <div class="ledger">
        <table class="plans">
          <thead>
            <tr><th>Plano</th><th class="num">Itens</th><th>Atualizado</th></tr>
          </thead>
          <tbody>
            @each(plan in plans)
              <tr>
                <td><a href="{{ route('plans.show', { id: plan.id }) }}" class="plans__name">{{ plan.name }}</a></td>
                <td class="num">{{ plan.$extras.items_count }}</td>
                <td class="muted">
                  {{ formatDate(plan.updatedAt) }}
                  @if(plan.updatedBy)
                    por {{ plan.updatedBy.fullName ?? plan.updatedBy.email }}
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty">
        <p>Nenhum plano ainda.</p>
        <a href="{{ route('calculator.show') }}" class="btn btn--secondary btn--sm">Abrir a calculadora</a>
      </div>
    @end
  @end
@end
