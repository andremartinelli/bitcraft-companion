@layouts.app({ title: 'Planos' })
  @page({ title: 'Planos', description: 'Planos salvos, compartilhados entre vocês. "Novo plano" cria um vazio: adicione itens ou construções, e cada mudança é salva sozinha.' })
    @slot('actions')
      @!plans.newButton({ variant: 'primary' })
    @end

    @if(quickPlans.length)
      <div class="quick-plans">
        @include('components/plans/quick_menu')
        <span class="muted">um set, as ferramentas ou o upgrade do assentamento de um tier, num plano novo</span>
      </div>
    @end

    @if(plans.length)
      <div class="ledger">
        <table class="plans">
          <thead>
            <tr><th>Plano</th><th class="num">Itens</th><th>Atualizado</th></tr>
          </thead>
          <tbody>
            @each(plan in plans)
              <tr>
                <td><a href="{{ route('plans.show', { id: plan.id }) }}" class="plans__name">{{ plan.name }}</a></td>
                <td class="num">{{ Number(plan.$extras.items_count) + Number(plan.$extras.buildings_count) }}</td>
                <td class="muted">
                  {{ formatDate(plan.updatedAt) }}
                  @if(plan.updatedBy)
                    por {{ plan.updatedBy.fullName ?? plan.updatedBy.email }}
                  @end
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty">
        <p>Nenhum plano ainda.</p>
        @!plans.newButton({ variant: 'secondary' })
      </div>
    @end
  @end
@end
