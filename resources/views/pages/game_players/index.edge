@layouts.app({ title: 'Personagens' })
  @page({ title: 'Personagens', description: 'Os personagens cujo inventário o app lê na API pública da BitJita. Só dados públicos: nada de senha nem token do jogo.' })
    @slot('actions')
      <a href="{{ route('inventory.index') }}" class="btn btn--secondary btn--sm">Inventário</a>
    @end

    @form({ route: 'game_players.store', method: 'POST', class: 'player-add' })
      @field.root({ name: 'username' })
        @!field.label({ text: 'Adicionar pelo nick' })
        <div class="player-add__row">
          @!input.control({ placeholder: 'Nick exato no jogo', autocomplete: 'off', maxlength: 40, required: true })
          <button type="submit" class="btn btn--primary btn--sm">Adicionar</button>
        </div>
        @!field.error()
      @end
    @end

    @if(players.length)
      <div class="ledger">
        <table class="plans">
          <thead>
            <tr><th>Personagem</th><th>Região</th><th>Claim</th><th>Última leitura</th><th></th></tr>
          </thead>
          <tbody>
            @each(player in players)
              <tr>
                <td class="plans__name">{{ player.username }}</td>
                <td>{{ player.regionId ? `Região ${player.regionId}` : '—' }}</td>
                <td>{{ player.claimNames || '—' }}</td>
                <td class="muted">
                  {{ player.lastSyncedAt ? formatAgo(player.lastSyncedAt) : 'ainda não' }}
                  @if(player.lastError)
                    <div class="player__error">Falhou na última vez: {{ player.lastError }}</div>
                  @end
                </td>
                <td>
                  <button
                    type="button"
                    class="btn btn--ghost btn--sm"
                    hx-delete="{{ route('game_players.destroy', { id: player.id }) }}"
                    hx-confirm="Remover {{ player.username }}? Os itens dele saem do inventário do app (nada muda no jogo)."
                  >
                    Remover
                  </button>
                </td>
              </tr>
            @end
          </tbody>
        </table>
      </div>
    @else
      <div class="empty">
        <p>Nenhum personagem ainda. Adicione o de cada um de vocês pelo nick.</p>
      </div>
    @end
  @end
@end
