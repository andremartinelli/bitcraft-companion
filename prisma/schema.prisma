// Database schema. The URL lives in prisma.config.ts (Prisma 7). Design: docs/design/2026-11-24-vercel.md
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemKind {
  item
  cargo

  @@map("item_kind")
}

enum RecipeKind {
  crafting
  construction

  @@map("recipe_kind")
}

/// resource: tree, vein, plant. enemy: a hunted animal.
enum ExtractionSource {
  resource
  enemy

  @@map("extraction_source")
}

enum ContainerKind {
  personal
  toolbelt
  wallet
  bank
  stash
  housing
  claim
  deployable
  other

  @@map("container_kind")
}

enum EntrySource {
  sync
  manual

  @@map("entry_source")
}

enum SyncTrigger {
  manual
  auto
  cron

  @@map("sync_trigger")
}

enum SyncStatus {
  running
  ok
  partial
  failed

  @@map("sync_status")
}

// ---------------------------------------------------------------- accounts

model User {
  id           Int         @id @default(autoincrement())
  fullName     String?     @map("full_name")
  email        String      @unique @db.VarChar(254)
  /// scrypt hash (node:crypto), never the password
  password     String
  /// Where the page sign-up came from: limits new accounts per IP
  signupIp     String?     @map("signup_ip")
  /// The account's character ("Meu personagem"). Two accounts can claim the same one
  gamePlayerId Int?        @map("game_player_id")
  gamePlayer   GamePlayer? @relation(fields: [gamePlayerId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  plansCreated    Plan[]             @relation("PlanCreatedBy")
  plansUpdated    Plan[]             @relation("PlanUpdatedBy")
  planShares      PlanShare[]
  groupsOwned     Group[]            @relation("GroupOwner")
  groupMembers    GroupMember[]
  groupInvites    GroupInvite[]      @relation("GroupInvitedBy")
  invitesReceived GroupInvite[]      @relation("GroupInvitee")
  syncRuns        SyncRun[]
  recipeChoices   UserRecipeChoice[]
  planSettings    PlanUserSetting[]
  countedClaims   CountedClaim[]

  @@index([signupIp, createdAt])
  @@index([gamePlayerId])
  @@map("users")
}

/// Sign-ups whose nick failed (BitJita didn't find it or was down).
/// They count toward the daily limit of new accounts per IP, like created accounts:
/// without it, sign-ups with made-up nicks would query BitJita without a limit.
model SignupNickFailure {
  id        Int      @id @default(autoincrement())
  ip        String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ip, createdAt])
  @@map("signup_nick_failures")
}

model LoginAttempt {
  id        Int      @id @default(autoincrement())
  email     String   @db.VarChar(254)
  ip        String?
  succeeded Boolean
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@map("login_attempts")
}

// ---------------------------------------------------------- game data

model GameDataImport {
  id         Int       @id @default(autoincrement())
  /// github, local or memory (tests)
  source     String
  commitSha  String?   @map("commit_sha")
  sourceDate DateTime? @map("source_date") @db.Timestamptz(3)
  counts     Json?
  renamed    Json?
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  graph RecipeGraphSnapshot?

  @@map("game_data_imports")
}

/// The calculator's recipe graph, as gzip-compressed JSON. It is written
/// by the import, in the same transaction. It lives in its own table so that
/// queries on game_data_imports never fetch these bytes.
model RecipeGraphSnapshot {
  importId  Int            @id @map("import_id")
  import    GameDataImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  data      Bytes
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("recipe_graph_snapshots")
}

/// The id is the game's
model Skill {
  id   Int    @id
  name String

  recipes           Recipe[]
  extractionRecipes ExtractionRecipe[]

  @@map("skills")
}

model ToolType {
  id   Int    @id
  name String

  recipes           Recipe[]
  extractionRecipes ExtractionRecipe[]

  @@map("tool_types")
}

model BuildingType {
  id   Int    @id
  name String

  recipes Recipe[]

  @@map("building_types")
}

/// A game item or cargo. Never deleted: when it leaves the game, it gets removed_at.
model Item {
  id             Int       @id @default(autoincrement())
  kind           ItemKind
  gameId         Int       @map("game_id")
  name           String
  description    String?
  tier           Int
  tag            String?
  rarity         String?
  /// The icon in the game ("GeneratedIcons/Items/Berries"); the image comes from BitJita (src/lib/item_icon.ts)
  iconAssetName  String?   @map("icon_asset_name")
  /// The game's item_list_id: this item is a random output ("... Output")
  itemListGameId Int?      @map("item_list_game_id")
  /// The same list by our id, resolved by the importer
  itemListId     Int?      @map("item_list_id")
  itemList       ItemList? @relation(fields: [itemListId], references: [id])
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)
  lastImportId   Int?      @map("last_import_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipeInputs      RecipeInput[]
  recipeOutputs     RecipeOutput[]
  listEntries       ItemListPossibilityItem[]
  claimTechInputs   ClaimTechInput[]
  extractionOutputs ExtractionRecipeOutput[]
  planItems         PlanItem[]
  planChoices       PlanChoice[]
  userRecipeChoices UserRecipeChoice[]
  planOwnedItems    PlanOwnedItem[]
  inventoryEntries  InventoryEntry[]

  @@unique([kind, gameId])
  @@index([name])
  @@index([itemListId])
  @@map("items")
}

model ItemList {
  id           Int       @id @default(autoincrement())
  gameId       Int       @unique @map("game_id")
  name         String
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  lastImportId Int?      @map("last_import_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  possibilities ItemListPossibility[]
  outputItems   Item[]

  @@map("item_lists")
}

model ItemListPossibility {
  id          Int      @id @default(autoincrement())
  itemListId  Int      @map("item_list_id")
  itemList    ItemList @relation(fields: [itemListId], references: [id], onDelete: Cascade)
  /// Order within the list, as it comes from the game
  position    Int
  probability Float

  items ItemListPossibilityItem[]

  @@unique([itemListId, position])
  @@map("item_list_possibilities")
}

model ItemListPossibilityItem {
  id            Int                 @id @default(autoincrement())
  possibilityId Int                 @map("possibility_id")
  possibility   ItemListPossibility @relation(fields: [possibilityId], references: [id], onDelete: Cascade)
  itemId        Int                 @map("item_id")
  item          Item                @relation(fields: [itemId], references: [id])
  quantity      Int

  @@index([possibilityId])
  @@index([itemId])
  @@map("item_list_possibility_items")
}

/// Craft or construction recipe. One skill, at most one tool and
/// at most one station (the importer stops with an error if a patch changes this).
model Recipe {
  id                     Int           @id @default(autoincrement())
  kind                   RecipeKind
  gameId                 Int           @map("game_id")
  /// With placeholders resolved: {0} is the first product, {1} the first ingredient
  name                   String
  /// Craft, Scrap, Cook...; "Build" for constructions
  verb                   String
  actionsRequired        Int           @map("actions_required")
  timePerAction          Float         @map("time_per_action")
  staminaPerAction       Float         @map("stamina_per_action")
  skillId                Int?          @map("skill_id")
  skill                  Skill?        @relation(fields: [skillId], references: [id])
  skillLevel             Int?          @map("skill_level")
  toolTypeId             Int?          @map("tool_type_id")
  toolType               ToolType?     @relation(fields: [toolTypeId], references: [id])
  toolTier               Int?          @map("tool_tier")
  buildingTypeId         Int?          @map("building_type_id")
  buildingType           BuildingType? @relation(fields: [buildingTypeId], references: [id])
  buildingTier           Int?          @map("building_tier")
  isPassive              Boolean       @default(false) @map("is_passive")
  hiddenWithoutKnowledge Boolean       @default(false) @map("hidden_without_knowledge")
  shards                 Int           @default(0)
  pavingTier             Int?          @map("paving_tier")
  removedAt              DateTime?     @map("removed_at") @db.Timestamptz(3)
  lastImportId           Int?          @map("last_import_id")
  createdAt              DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  inputs            RecipeInput[]
  outputs           RecipeOutput[]
  planChoices       PlanChoice[]
  userRecipeChoices UserRecipeChoice[]
  planBuildings     PlanBuilding[]

  @@unique([kind, gameId])
  @@index([verb])
  @@index([skillId])
  @@index([buildingTypeId])
  @@map("recipes")
}

model RecipeInput {
  id       Int    @id @default(autoincrement())
  recipeId Int    @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   Int    @map("item_id")
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int

  @@index([recipeId])
  @@index([itemId])
  @@map("recipe_inputs")
}

model RecipeOutput {
  id       Int    @id @default(autoincrement())
  recipeId Int    @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  itemId   Int    @map("item_id")
  item     Item   @relation(fields: [itemId], references: [id])
  quantity Int

  @@index([recipeId])
  @@index([itemId])
  @@map("recipe_outputs")
}

/// Settlement research: tier upgrade, Township, Homestead...
model ClaimTech {
  id           Int       @id @default(autoincrement())
  gameId       Int       @unique @map("game_id")
  name         String
  description  String?
  tier         Int
  /// TierUpgrade, Settlement, Homestead, Carpentry, MemberCount...
  techType     String    @map("tech_type")
  /// Settlement supplies, which are not items
  suppliesCost Int       @default(0) @map("supplies_cost")
  /// Doesn't show in the game, or can't be researched
  hidden       Boolean   @default(false)
  removedAt    DateTime? @map("removed_at") @db.Timestamptz(3)
  lastImportId Int?      @map("last_import_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  inputs ClaimTechInput[]

  @@index([techType, tier])
  @@map("claim_techs")
}

model ClaimTechInput {
  id          Int       @id @default(autoincrement())
  claimTechId Int       @map("claim_tech_id")
  claimTech   ClaimTech @relation(fields: [claimTechId], references: [id], onDelete: Cascade)
  itemId      Int       @map("item_id")
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int

  @@index([claimTechId])
  @@map("claim_tech_inputs")
}

/// World gathering (Chop, Mine, Gather...) or hunting (Hunt, Slay)
model ExtractionRecipe {
  id           Int              @id @default(autoincrement())
  source       ExtractionSource @default(resource)
  gameId       Int              @map("game_id")
  verb         String
  skillId      Int?             @map("skill_id")
  skill        Skill?           @relation(fields: [skillId], references: [id])
  skillLevel   Int?             @map("skill_level")
  toolTypeId   Int?             @map("tool_type_id")
  toolType     ToolType?        @relation(fields: [toolTypeId], references: [id])
  toolTier     Int?             @map("tool_tier")
  removedAt    DateTime?        @map("removed_at") @db.Timestamptz(3)
  lastImportId Int?             @map("last_import_id")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  outputs ExtractionRecipeOutput[]

  @@unique([source, gameId])
  @@index([skillId])
  @@map("extraction_recipes")
}

model ExtractionRecipeOutput {
  id                 Int              @id @default(autoincrement())
  extractionRecipeId Int              @map("extraction_recipe_id")
  extractionRecipe   ExtractionRecipe @relation(fields: [extractionRecipeId], references: [id], onDelete: Cascade)
  itemId             Int              @map("item_id")
  item               Item             @relation(fields: [itemId], references: [id])
  quantity           Int

  @@index([extractionRecipeId])
  @@index([itemId])
  @@map("extraction_recipe_outputs")
}

// ------------------------------------------------------------------ plans

/// A named calculator state. It belongs to whoever created it (created_by_id), who
/// can share it with other accounts (plan_shares).
model Plan {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(80)
  notes       String?
  createdById Int?     @map("created_by_id")
  createdBy   User?    @relation("PlanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById Int?     @map("updated_by_id")
  updatedBy   User?    @relation("PlanUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  items        PlanItem[]
  buildings    PlanBuilding[]
  choices      PlanChoice[]
  ownedItems   PlanOwnedItem[]
  shares       PlanShare[]
  groupShares  PlanGroupShare[]
  userSettings PlanUserSetting[]

  @@index([createdById])
  @@map("plans")
}

/// "Todos do grupo" on the plan: whoever is in the group sees and edits it, including people who join later
model PlanGroupShare {
  planId    Int      @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  groupId   Int      @map("group_id")
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([planId, groupId])
  @@index([groupId])
  @@map("plan_group_shares")
}

/// Accounts that share plans with each other. Only the creator invites and removes people
model Group {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(60)
  ownerId   Int      @map("owner_id")
  owner     User     @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members    GroupMember[]
  invites    GroupInvite[]
  planShares PlanGroupShare[]

  @@index([ownerId])
  @@map("groups")
}

/// An account in the group, the owner too. An account can be in several groups
model GroupMember {
  groupId        Int      @map("group_id")
  group          Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId         Int      @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// This account's new plans are born already shared with the group
  autoSharePlans Boolean  @default(false) @map("auto_share_plans")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

/// An invite: a link (token) the owner sends to the person. The app doesn't confirm e-mails,
/// so the invite only shows on the "Conta" page of an account that already had that e-mail when invited
model GroupInvite {
  id          Int      @id @default(autoincrement())
  groupId     Int      @map("group_id")
  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  /// Lowercase, like account e-mails: it only identifies the invite for the owner
  email       String   @db.VarChar(254)
  /// The secret of the /invites/[token] link: whoever has the link accepts
  token       String   @unique @db.VarChar(64)
  /// The account that already had the e-mail when invited: sees the invite on the "Conta" page
  userId      Int?     @map("user_id")
  user        User?    @relation("GroupInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedById Int?     @map("invited_by_id")
  invitedBy   User?    @relation("GroupInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([groupId, email])
  @@index([userId])
  @@map("group_invites")
}

/// An account the owner shared the plan with: it sees and edits, can't delete
model PlanShare {
  planId    Int      @map("plan_id")
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([planId, userId])
  @@index([userId])
  @@map("plan_shares")
}

/// What each person chose for themselves on a plan. It doesn't change what others see
model PlanUserSetting {
  planId          Int      @map("plan_id")
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId          Int      @map("user_id")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Usar apenas meu inventário": only my character, without the plan's other people
  onlyMyInventory Boolean  @default(false) @map("only_my_inventory")
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([planId, userId])
  @@index([userId])
  @@map("plan_user_settings")
}

model PlanItem {
  id       Int  @id @default(autoincrement())
  planId   Int  @map("plan_id")
  plan     Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId   Int  @map("item_id")
  item     Item @relation(fields: [itemId], references: [id])
  quantity Int
  position Int  @default(0)

  @@unique([planId, itemId])
  @@map("plan_items")
}

/// A construction in the plan (construction recipe)
model PlanBuilding {
  id       Int    @id @default(autoincrement())
  planId   Int    @map("plan_id")
  plan     Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  recipeId Int    @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id])
  quantity Int
  position Int    @default(0)

  @@unique([planId, recipeId])
  @@map("plan_buildings")
}

model PlanChoice {
  id       Int     @id @default(autoincrement())
  planId   Int     @map("plan_id")
  plan     Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId   Int     @map("item_id")
  item     Item    @relation(fields: [itemId], references: [id])
  /// null: treat the item as a raw material
  recipeId Int?    @map("recipe_id")
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  @@unique([planId, itemId])
  @@map("plan_choices")
}

/// The recipe the account chose for an item ("Trocar receita"): new plans
/// are born with it and the quick calculator uses it
model UserRecipeChoice {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId   Int    @map("item_id")
  item     Item   @relation(fields: [itemId], references: [id])
  recipeId Int    @map("recipe_id")
  recipe   Recipe @relation(fields: [recipeId], references: [id])

  @@unique([userId, itemId])
  @@map("user_recipe_choices")
}

model PlanOwnedItem {
  id       Int  @id @default(autoincrement())
  planId   Int  @map("plan_id")
  plan     Plan @relation(fields: [planId], references: [id], onDelete: Cascade)
  itemId   Int  @map("item_id")
  item     Item @relation(fields: [itemId], references: [id])
  quantity Int

  @@unique([planId, itemId])
  @@map("plan_owned_items")
}

// -------------------------------------------------------------- inventory

/// A character, by BitJita's public entityId. No token. It is an
/// account's (users.game_player_id) and exists only once, even if two accounts choose it.
model GamePlayer {
  id            Int       @id @default(autoincrement())
  username      String
  /// 18 digits: doesn't fit in a JavaScript number
  entityId      String    @unique @map("entity_id")
  regionId      Int?      @map("region_id")
  /// The character's claims at the last read: [{ entityId, name }]
  claims        Json?
  /// The last successful read
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamptz(3)
  /// The last attempt, successful or not: decides whether it's time to read again
  lastAttemptAt DateTime? @map("last_attempt_at") @db.Timestamptz(3)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  containers InventoryContainer[]
  accounts   User[]

  @@map("game_players")
}

/// A claim whose chests count toward the account's inventory, switched on in
/// "Meu personagem" (decided 26/11/2026). Only claims of the account's character:
/// BitJita reads a claim's chests while someone counts it. Whole claims only, since
/// BitJita does not say which chests a member can open (issue #25).
model CountedClaim {
  userId        Int      @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// BitJita's entityId of the claim: 18 digits
  claimEntityId String   @map("claim_entity_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, claimEntityId])
  @@index([claimEntityId])
  @@map("counted_claims")
}

model InventoryContainer {
  id            Int           @id @default(autoincrement())
  kind          ContainerKind
  /// entityId of the inventory or building, as BitJita sends it
  gameEntityId  String        @map("game_entity_id")
  /// Null in the claim's chests, which belong to the group
  gamePlayerId  Int?          @map("game_player_id")
  gamePlayer    GamePlayer?   @relation(fields: [gamePlayerId], references: [id], onDelete: Cascade)
  claimEntityId String?       @map("claim_entity_id")
  claimName     String?       @map("claim_name")
  name          String
  lastSeenAt    DateTime?     @map("last_seen_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  entries InventoryEntry[]

  @@unique([kind, gameEntityId])
  @@index([claimEntityId])
  @@map("inventory_containers")
}

model InventoryEntry {
  id          Int                @id @default(autoincrement())
  containerId Int                @map("container_id")
  container   InventoryContainer @relation(fields: [containerId], references: [id], onDelete: Cascade)
  itemId      Int                @map("item_id")
  item        Item               @relation(fields: [itemId], references: [id])
  quantity    Int
  source      EntrySource        @default(sync)
  syncedAt    DateTime?          @map("synced_at") @db.Timestamptz(3)

  @@unique([containerId, itemId, source])
  @@index([itemId])
  @@map("inventory_entries")
}

/// An inventory sync. The unique partial index (SQL in the migration) guarantees a
/// single "running" at a time:
///   CREATE UNIQUE INDEX sync_runs_one_running ON sync_runs (status) WHERE status = 'running';
model SyncRun {
  id         Int         @id @default(autoincrement())
  trigger    SyncTrigger
  /// bitjita
  source     String
  status     SyncStatus
  message    String?
  counts     Json?
  /// The account whose characters were read; null in the cron, which reads everyone's
  userId     Int?        @map("user_id")
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt  DateTime    @map("started_at") @db.Timestamptz(3)
  finishedAt DateTime?   @map("finished_at") @db.Timestamptz(3)

  @@index([status])
  @@index([startedAt])
  @@index([userId, startedAt])
  @@map("sync_runs")
}
